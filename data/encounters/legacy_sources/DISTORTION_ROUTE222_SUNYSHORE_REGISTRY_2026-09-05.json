  "scope": "Spear Pillar / Distortion World encounter policy + Route 222 / Sunyshore encounter specification",
  "status": "STAGED_FOR_FINAL_SINNOH_MAPS",
  "design_source": "Pokemon Platinum / Sinnoh, expanded for Mercury Redux",
  "source_rule": "Platinum/Sinnoh defines geography, encounter anchors, ecology, and progression. Emerald-derived engine IDs are hidden implementation infrastructure only and are not content sources.",
  "runtime_note": "The final player-facing Spear Pillar, Distortion World, Route 222, and Sunyshore maps are not yet constructed in this cumulative source. Do not attach these encounter specs to unrelated engine geography.",
  "story_static_policy": {
    "SPEAR_PILLAR": {
      "random_wild_encounters": false,
      "story_encounters": [
        "Dialga/Palkia remain story-controlled during the Galactic climax; they are not random encounters.",
        "Giratina interrupts Cyrus and opens the Distortion World as in Platinum."
      ]
    },
    "DISTORTION_WORLD": {
      "random_wild_encounters": false,
      "reason": "Platinum explicitly has no ordinary wild Pok\u00e9mon in the Distortion World. Its emptiness is preserved as part of the area identity.",
      "scripted_static": [
        {
          "species": "SPECIES_GIRATINA_ORIGIN",
          "level": 60,
          "role": "Mandatory story/static encounter at the end of the Distortion World",
          "capture_allowed": true
        }
      ],
      "retry_policy": "Mercury QoL: if Giratina is defeated or the player flees, the story encounter remains recoverable before the League rather than becoming a postgame-only loss. Exact reset/respawn script is staged for the final Distortion World map implementation.",
      "time_policy": "The global clock continues to exist for save/evolution systems, but Distortion World has no day/night encounter tables because it has no random encounters.",
      "lake_guardians": "Uxie, Mesprit, and Azelf are story guides/puzzle actors here, not random encounters.",
      "cyrus": "Final Cyrus battle remains a scripted boss encounter before Giratina."
    },
    "TURNBACK_CAVE_FUTURE_POLICY": {
      "status": "DEFERRED_TO_LATER_MAP_PASS",
      "note": "Do not use Turnback Cave to justify random Distortion World encounters. It will receive its own Platinum-based cave audit later, including pre-League availability decisions needed by Mercury\u2019s all-supported-Pok\u00e9mon-before-postgame policy."
    }
  },
